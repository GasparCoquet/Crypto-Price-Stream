# Crypto Price Stream Configuration

# Trading pair (e.g., ethbtc, btcusdt)
PAIR=ethbtc

# Alert threshold for price changes (percentage)
ALERT_THRESHOLD=0.5

# HTTP server port
PORT=3000

# Telegram Bot Configuration (optional)
# Get your bot token from @BotFather on Telegram
TELEGRAM_TOKEN=
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=
